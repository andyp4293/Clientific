generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id                           String                 @id @default(cuid())
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  email                        String                 @unique
  emailVerifiedAt              DateTime?
  emailVerificationTokenHash   String?
  emailVerificationTokenExpiry DateTime?
  verificationSentAt           DateTime?
  passwordHash                 String
  name                         String
  slug                         String                 @unique
  publicId                     String?                @unique
  businessType                 String
  phone                        String
  businessEmail                String?
  street                       String?
  city                         String?
  state                        String?
  zipCode                      String?
  country                      String?
  timezone                     String                 @default("America/New_York")
  logoUrl                      String?
  publicProfileHeadline        String?
  publicProfileAbout           String?
  publicProfileShowPhone       Boolean                @default(true)
  publicProfileShowEmail       Boolean                @default(true)
  publicProfileShowAddress     Boolean                @default(true)
  publicProfileShowHours       Boolean                @default(true)
  publicProfileShowServices    Boolean                @default(true)
  publicProfileShowTeam        Boolean                @default(false)
  publicProfileShowSocialLinks Boolean                @default(true)
  googleReviewUrl              String?
  facebookPageUrl              String?
  yelpUrl                      String?
  instagramUrl                 String?
  subscriptionPlan             String                 @default("trial")
  subscriptionStatus           String                 @default("trialing")
  trialEndsAt                  DateTime?
  stripeCustomerId             String?                @unique
  stripeSubscriptionId         String?                @unique
  stripePriceId                String?
  stripeCurrentPeriodEnd       DateTime?
  stripeConnectAccountId       String?                @unique
  stripeConnectChargesEnabled  Boolean                @default(false)
  stripeConnectPayoutsEnabled  Boolean                @default(false)
  stripeConnectDetailsSubmitted Boolean               @default(false)
  stripeConnectOnboardedAt     DateTime?
  stripeConnectLastSyncedAt    DateTime?
  resetToken                   String?
  resetTokenExpiry             DateTime?
  enableOnlineBooking          Boolean                @default(true)
  aiReceptionistEnabled        Boolean                @default(false)
  aiReceptionistPhone          String?
  aiReceptionistGreeting       String?
  aiReceptionistFaq            Json?
  smsAiEnabled                 Boolean                @default(false)
  smsAiPhoneNumber             String?
  smsAiGreeting                String?
  vapiPhoneNumberId            String?
  vapiPhoneNumber              String?
  notifyNewBookingEmail        Boolean                @default(true)
  referralCode                 String?                @unique
  referredById                 String?
  referralCredits              Float                  @default(0)
  affiliateCodeUsed            String?
  referredBy                   Business?              @relation("BizReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                    Business[]             @relation("BizReferrals")
  referralsMade                Referral[]             @relation("ReferrerOf")
  referralReceived             Referral?              @relation("RefereeOf")
  affiliateSignup              AffiliateSignup?
  appointments                 Appointment[]
  businessHours                BusinessHours?
  checkIns                     CheckIn[]
  customers                    Customer[]
  deals                        Deal[]
  dealPurchases                DealPurchase[]
  dealNotificationSends        DealNotificationSend[]
  invoices                     Invoice[]
  notifications                Notification[]
  payments                     Payment[]
  serviceGroups                ServiceGroup[]
  services                     Service[]
  smsLogs                      SmsLog[]               @relation("SmsLogs")
  smsAiSessions                SmsAiSession[]         @relation("BusinessSmsAiSessions")
  smsConsentEvents             SmsConsentEvent[]      @relation("BusinessSmsConsentEvents")
  staff                        Staff[]
  bankAccount                  BusinessBankAccount?
}

model BusinessBankAccount {
  id                      String   @id @default(cuid())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  businessId              String   @unique
  stripeExternalAccountId String?
  bankName                String?
  last4                   String
  routingNumberLast4      String
  accountHolderName       String?
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String   @unique
  hours      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Customer {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  businessId            String
  name                  String
  phone                 String?
  email                 String?
  birthday              DateTime?
  segment               String                 @default("NEW")
  totalSpent            Float                  @default(0)
  lastVisit             DateTime?
  optedInMarketing      Boolean                @default(true)
  optedOutAt            DateTime?
  notes                 String?
  smsConsent            Boolean                @default(false)
  smsMarketingConsent   Boolean                @default(false)
  smsMarketingConsentAt DateTime?
  smsOptedOut           Boolean                @default(false)
  smsOptedOutAt         DateTime?
  appointments          Appointment[]
  checkIns              CheckIn[]
  dealRedemptions       DealRedemption[]
  dealPurchases         DealPurchase[]
  dealNotificationSends DealNotificationSend[]
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  smsConsentEvents      SmsConsentEvent[]      @relation("CustomerSmsConsentEvents")

  @@index([businessId, segment])
  @@index([businessId, lastVisit])
}

model CheckIn {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  businessId          String
  customerId          String
  serviceId           String?
  staffId             String?
  checkInTime         DateTime  @default(now())
  amountSpent         Float?
  feedbackRequested   Boolean   @default(false)
  feedbackRequestedAt DateTime?
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service             Service?  @relation(fields: [serviceId], references: [id])
  staff               Staff?    @relation(fields: [staffId], references: [id])

  @@index([businessId, checkInTime])
  @@index([customerId, checkInTime])
}

model Appointment {
  id               String   @id @default(cuid())
  shortId          String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  businessId       String
  customerId       String
  serviceId        String?
  serviceIds       String[] @default([])
  staffId          String?
  startTime        DateTime
  endTime          DateTime
  duration         Int
  notes            String?
  status           String   @default("scheduled")
  source           String   @default("dashboard")
  confirmationSent Boolean  @default(false)
  reminderSent     Boolean  @default(false)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service          Service? @relation(fields: [serviceId], references: [id])
  staff            Staff?   @relation(fields: [staffId], references: [id])

  @@index([businessId, startTime])
  @@index([customerId, startTime])
}

model Service {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String
  groupId      String?
  name         String
  description  String?
  duration     Int
  price        Float?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  appointments      Appointment[]
  checkIns          CheckIn[]
  deals             Deal[]
  dealEligibleFor   Deal[]         @relation("DealEligibleServices")
  staffAssignments  StaffService[]
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group             ServiceGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([businessId, active])
  @@index([businessId, groupId, sortOrder])
}

model ServiceGroup {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  businessId String
  name       String
  sortOrder  Int       @default(0)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]

  @@index([businessId, sortOrder])
}

model Staff {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  businessId      String
  fullName        String
  email           String?
  phone           String?
  role            String         @default("staff")
  active          Boolean        @default(true)
  workDays        Int[]          @default([0, 1, 2, 3, 4, 5, 6])
  appointments    Appointment[]
  checkIns        CheckIn[]
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceAssignments StaffService[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model SmsLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  businessId   String
  toPhone      String
  message      String
  messageType  String
  status       String   @default("sent")
  errorMessage String?
  twilioSid    String?  @unique
  business     Business @relation("SmsLogs", fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([toPhone])
}

model SmsConsentEvent {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  businessId  String?
  customerId  String?
  phone       String
  eventType   String
  source      String
  messageSid  String?
  messageBody String?
  fromPhone   String?
  toPhone     String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  business    Business? @relation("BusinessSmsConsentEvents", fields: [businessId], references: [id], onDelete: SetNull)
  customer    Customer? @relation("CustomerSmsConsentEvents", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([eventType, createdAt])
  @@index([businessId, createdAt])
}

model SmsAiSession {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  businessId       String
  phone            String
  state            String    @default("idle")
  turns            Int       @default(0)
  serviceId        String?
  staffId          String?
  requestedDate    String?
  requestedTime    String?
  selectedSlotTime DateTime?
  customerName     String?
  notes            String?
  pendingOptions   Json?
  lastInboundText  String?
  lastOutboundText String?
  lastIntent       String?
  business         Business  @relation("BusinessSmsAiSessions", fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([businessId, updatedAt])
}

model Notification {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  businessId String
  type       String
  title      String
  message    String
  link       String?
  read       Boolean   @default(false)
  readAt     DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, read, createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  businessId      String
  amount          Int
  currency        String   @default("usd")
  status          String
  stripePaymentId String   @unique
  stripeInvoiceId String?
  description     String?
  receiptUrl      String?
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Invoice {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  businessId       String
  stripeInvoiceId  String    @unique
  amount           Int
  currency         String    @default("usd")
  status           String
  periodStart      DateTime
  periodEnd        DateTime
  invoicePdf       String?
  hostedInvoiceUrl String?
  paidAt           DateTime?
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status])
}

model Deal {
  id                 String                 @id @default(cuid())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  businessId         String
  title              String
  description        String?
  deliveryType       String                 @default("code_claim")
  serviceScope       String                 @default("selected_services")
  discountType       String // "percent_off" | "amount_off" | "free_service"
  discountValue      Float                  @default(0)
  serviceId          String?
  startsAt           DateTime
  expiresAt          DateTime
  maxRedemptions     Int?
  redemptionCount    Int                    @default(0)
  active             Boolean                @default(true)
  platformFeePercent Float                  @default(15)
  notifiedAt         DateTime?
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service            Service?               @relation(fields: [serviceId], references: [id])
  eligibleServices   Service[]              @relation("DealEligibleServices")
  redemptions        DealRedemption[]
  purchases          DealPurchase[]
  notificationSends  DealNotificationSend[]

  @@index([businessId, active])
}

model DealNotificationSend {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  businessId    String
  dealId        String
  customerId    String?
  customerName  String?
  customerPhone String
  code          String?
  purchaseUrl   String?
  deliveryType  String    @default("code_claim")
  status        String    @default("sent")
  errorMessage  String?
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([dealId, createdAt])
  @@index([customerId, createdAt])
}

model DealRedemption {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  dealId            String
  customerId        String?
  code              String    @unique
  usedAt            DateTime?
  transactionAmount Float?
  platformFee       Float?
  deal              Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  customer          Customer? @relation(fields: [customerId], references: [id])

  @@index([dealId, createdAt])
}

model DealPurchase {
  id                        String             @id @default(cuid())
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  dealId                    String
  businessId                String
  customerId                String?
  token                     String             @unique
  status                    String             @default("pending")
  customerName              String
  customerPhone             String
  customerEmail             String?
  currency                  String             @default("usd")
  subtotalAmount            Int
  discountAmount            Int
  totalAmount               Int
  applicationFeeAmount      Int
  businessNetAmount         Int
  stripeCheckoutSessionId   String?            @unique
  stripePaymentIntentId     String?            @unique
  stripeChargeId            String?            @unique
  stripeReceiptUrl          String?
  redemptionCode            String?            @unique
  purchasedAt               DateTime?
  redeemedAt                DateTime?
  expiresAt                 DateTime?
  smsConfirmationSentAt     DateTime?
  smsConfirmationError      String?
  deal                      Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  business                  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                     DealPurchaseItem[]

  @@index([businessId, createdAt])
  @@index([dealId, createdAt])
  @@index([customerId, createdAt])
  @@index([customerPhone, createdAt])
  @@index([status, createdAt])
}

model DealPurchaseItem {
  id                   String       @id @default(cuid())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  purchaseId           String
  serviceId            String?
  serviceName          String
  quantity             Int          @default(1)
  originalUnitAmount   Int
  discountedUnitAmount Int
  purchase             DealPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId, createdAt])
}

model Referral {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  creditedAt   DateTime?
  referrerId   String
  refereeId    String               @unique
  status       String               @default("pending")
  creditAmount Float                @default(0)
  referrer     Business             @relation("ReferrerOf", fields: [referrerId], references: [id])
  referee      Business             @relation("RefereeOf", fields: [refereeId], references: [id])
  commissions  ReferralCommission[]

  @@index([referrerId])
}

model ReferralCommission {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  referralId      String
  stripeInvoiceId String   @unique
  amountDollars   Float
  transferStatus  String   @default("pending")
  stripeTransferId String?
  transferredAt   DateTime?
  transferFailureReason String?
  referral        Referral @relation(fields: [referralId], references: [id])

  @@index([referralId])
  @@index([transferStatus])
  @@index([stripeTransferId])
}

model Affiliate {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now())
  name       String
  email      String            @unique
  code       String            @unique
  payoutInfo String?
  active     Boolean           @default(true)
  signups    AffiliateSignup[]
}

model AffiliateSignup {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  affiliateId String
  businessId  String    @unique
  status      String    @default("pending")
  earnAmount  Float     @default(0)
  earnedAt    DateTime?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([affiliateId])
}
