generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id                     String         @id @default(cuid())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  email                  String         @unique
  passwordHash           String
  name                   String
  slug                   String         @unique
  publicId               String?        @unique
  businessType           String
  phone                  String
  businessEmail          String?
  street                 String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?
  timezone               String         @default("America/New_York")
  logoUrl                String?
  googleReviewUrl        String?
  facebookPageUrl        String?
  yelpUrl                String?
  instagramUrl           String?
  subscriptionPlan       String         @default("trial")
  subscriptionStatus     String         @default("trialing")
  trialEndsAt            DateTime?
  stripeCustomerId       String?        @unique
  stripeSubscriptionId   String?        @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  resetToken             String?
  resetTokenExpiry       DateTime?
  enableOnlineBooking    Boolean        @default(true)
  enableBirthdayCampaign Boolean        @default(true)
  aiReceptionistEnabled  Boolean        @default(false)
  aiReceptionistPhone    String?
  aiReceptionistGreeting String?
  pointsPerDollar        Float          @default(1.0)
  pointsPerVisit         Int            @default(10)
  referralBonusPoints    Int            @default(50)
  appointments           Appointment[]
  businessHours          BusinessHours?
  campaigns              Campaign[]
  checkIns               CheckIn[]
  customers              Customer[]
  invoices               Invoice[]
  notifications          Notification[]
  payments               Payment[]
  rewards                Reward[]
  services               Service[]
  smsLogs                SmsLog[]       @relation("SmsLogs")
  staff                  Staff[]
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String   @unique
  hours      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  businessId         String
  name               String
  phone              String?
  email              String?
  birthday           DateTime?
  segment            String              @default("NEW")
  totalSpent         Float               @default(0)
  lastVisit          DateTime?
  points             Int                 @default(0)
  optedInMarketing   Boolean             @default(true)
  optedOutAt         DateTime?
  notes              String?
  smsConsent         Boolean             @default(false)
  smsOptedOut        Boolean             @default(false)
  smsOptedOutAt      DateTime?
  appointments       Appointment[]
  checkIns           CheckIn[]
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointsTransactions PointsTransaction[]
  redemptions        Redemption[]

  @@index([businessId, segment])
  @@index([businessId, lastVisit])
}

model CheckIn {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  businessId          String
  customerId          String
  serviceId           String?
  staffId             String?
  checkInTime         DateTime  @default(now())
  amountSpent         Float?
  pointsEarned        Int       @default(0)
  feedbackRequested   Boolean   @default(false)
  feedbackRequestedAt DateTime?
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service             Service?  @relation(fields: [serviceId], references: [id])
  staff               Staff?    @relation(fields: [staffId], references: [id])

  @@index([businessId, checkInTime])
  @@index([customerId, checkInTime])
}

model Appointment {
  id               String   @id @default(cuid())
  shortId          String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  businessId       String
  customerId       String
  serviceId        String?
  staffId          String?
  startTime        DateTime
  endTime          DateTime
  duration         Int
  notes            String?
  status           String   @default("scheduled")
  confirmationSent Boolean  @default(false)
  reminderSent     Boolean  @default(false)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service          Service? @relation(fields: [serviceId], references: [id])
  staff            Staff?   @relation(fields: [staffId], references: [id])

  @@index([businessId, startTime])
  @@index([customerId, startTime])
}

model Service {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String
  name         String
  description  String?
  duration     Int
  price        Float?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  appointments Appointment[]
  checkIns     CheckIn[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active])
}

model Staff {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String
  fullName     String
  email        String?
  phone        String?
  role         String        @default("staff")
  active       Boolean       @default(true)
  appointments Appointment[]
  checkIns     CheckIn[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Reward {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessId     String
  name           String
  description    String
  pointsCost     Int
  rewardType     String
  rewardValue    Float?
  active         Boolean      @default(true)
  expirationDays Int?
  redemptions    Redemption[]
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active])
}

model Redemption {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customerId  String
  rewardId    String
  pointsSpent Int
  code        String    @unique
  used        Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward      Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model PointsTransaction {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  customerId   String
  amount       Int
  description  String
  balanceAfter Int
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model Campaign {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  businessId     String
  name           String
  type           String
  message        String
  targetSegments String[]
  status         String    @default("draft")
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model SmsLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  businessId   String
  toPhone      String
  message      String
  messageType  String
  status       String   @default("sent")
  errorMessage String?
  twilioSid    String?  @unique
  business     Business @relation("SmsLogs", fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([toPhone])
}

model Notification {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  businessId String
  type       String
  title      String
  message    String
  link       String?
  read       Boolean   @default(false)
  readAt     DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, read, createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  businessId      String
  amount          Int
  currency        String   @default("usd")
  status          String
  stripePaymentId String   @unique
  stripeInvoiceId String?
  description     String?
  receiptUrl      String?
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Invoice {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  businessId       String
  stripeInvoiceId  String    @unique
  amount           Int
  currency         String    @default("usd")
  status           String
  periodStart      DateTime
  periodEnd        DateTime
  invoicePdf       String?
  hostedInvoiceUrl String?
  paidAt           DateTime?
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status])
}
