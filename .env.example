# Environment variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clientflow"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Optional app-level abuse controls. Leave unset for the production defaults.
RATE_LIMIT_DISABLED="false"
RATE_LIMIT_TRUSTED_IPS=""

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+18557654989" # Verified toll-free sender used for outbound SMS
TWILIO_MESSAGING_SERVICE_SID="" # Optional; outbound in this repo uses TWILIO_PHONE_NUMBER directly

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@clientflow.com"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mapbox API (for address autocomplete)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="your-mapbox-token-here"
